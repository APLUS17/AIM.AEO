# Copy to .env.local for local dev, and add the same names in Vercel:
# Project > Settings > Environment Variables. Never commit real keys.

# --- AI engines (each key you set gets checked) ---
# Required for live mode: Claude is an engine AND the grader.
ANTHROPIC_API_KEY=
# ChatGPT
OPENAI_API_KEY=
# Perplexity
PERPLEXITY_API_KEY=

# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5
# Cheaper grading:
# JUDGE_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-5-mini
# PERPLEXITY_MODEL=sonar
# 1-3. More runs = steadier score, higher cost.
# RUNS_PER_PROMPT=1

# --- Email delivery (Resend) ---
RESEND_API_KEY=
# e.g. BrandName <grader@yourdomain.com> (domain must be verified in Resend)
FROM_EMAIL=
# Gets a copy of every lead
OWNER_EMAIL=
# Link in the report's call-to-action, e.g. https://yourdomain.com
SITE_URL=

# Force sample data even when keys are set:
# GRADER_MODE=mock
